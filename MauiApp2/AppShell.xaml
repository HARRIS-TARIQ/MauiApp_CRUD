<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp2.Views"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#F8FAFC"
    FlyoutWidth="320"
    Shell.NavBarIsVisible="True"
    Title="EVC Console">

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#5B4DFF" Padding="24">
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="EVC Console"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Operations Dashboard"
                    FontSize="13"
                    TextColor="#EDE9FF"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Dashboard -->
    <FlyoutItem
        Route="Dashboard"
        Title="Dashboard"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="DashboardPage"
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}" />

    </FlyoutItem>

    <!-- Products -->
    <FlyoutItem
        Route="Products"
        Title="Products"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="ProductListPage"
            Title="Products"
            ContentTemplate="{DataTemplate views:ProductListPage}" />

    </FlyoutItem>

    <!-- Devices -->
    <FlyoutItem
        Route="Devices"
        Title="Devices"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="DeviceListPage"
            Title="Devices"
            ContentTemplate="{DataTemplate views:DeviceListPage}" />

    </FlyoutItem>

    <!-- Monitoring -->
    <FlyoutItem
        Route="Monitoring"
        Title="Monitoring"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="LiveMonitoringPage"
            Title="Live Monitoring"
            ContentTemplate="{DataTemplate views:LiveMonitoringPage}" />

    </FlyoutItem>

    <!-- Reports -->
    <FlyoutItem
        Route="Reports"
        Title="Reports"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="ReportsPage"
            Title="Reports"
            ContentTemplate="{DataTemplate views:ReportsPage}" />

    </FlyoutItem>

    <!-- Settings -->
    <FlyoutItem
        Route="Settings"
        Title="Settings"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Route="SettingsPage"
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />

    </FlyoutItem>

</Shell>