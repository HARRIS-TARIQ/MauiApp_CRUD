<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp2"
    xmlns:views="clr-namespace:MauiApp2.Views"
    Title="MauiApp2"
    FlyoutBackgroundColor="#F8FAFC">

    <Shell.FlyoutHeader>
        <Border Padding="24" BackgroundColor="#5B4DFF">
            <VerticalStackLayout Spacing="6">
                <Label Text="EVC Console" FontSize="22" FontAttributes="Bold" TextColor="White" />
                <Label Text="Operations dashboard" FontSize="13" TextColor="#EDE9FF" />
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <ShellContent
        Route="LoginPage"
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <FlyoutItem Route="DashboardPage" Title="Dashboard">
        <ShellContent Title="Overview" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Route="Products" Title="Products">
        <ShellContent Title="Inventory" ContentTemplate="{DataTemplate views:ProductListPage}" />
    </FlyoutItem>

    <FlyoutItem Route="Devices" Title="Devices">
        <ShellContent Title="Device Inventory" ContentTemplate="{DataTemplate views:DeviceListPage}" />
    </FlyoutItem>

    <FlyoutItem Route="Monitoring" Title="Monitoring">
        <ShellContent Title="Live Monitoring" ContentTemplate="{DataTemplate views:LiveMonitoringPage}" />
    </FlyoutItem>

    <FlyoutItem Route="Reports" Title="Reports">
        <ShellContent Title="Reports" ContentTemplate="{DataTemplate views:ReportsPage}" />
    </FlyoutItem>

    <FlyoutItem Route="Settings" Title="Settings">
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

</Shell>
