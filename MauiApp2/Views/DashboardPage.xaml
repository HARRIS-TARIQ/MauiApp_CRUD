<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MauiApp2.ViewModels"
    x:Class="MauiApp2.Views.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="#F6F8FC"
    Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 28">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="#6A5AE0" Offset="0" />
                        <GradientStop Color="#4A36C8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Padding="24">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Welcome back 👋" FontSize="16" TextColor="#D8D4FF" />
                        <Label Text="{Binding CurrentUserName}" FontSize="30" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Stay on top of devices, inventory, and operations from one calm workspace." FontSize="14" TextColor="#ECEAFF" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Overview" FontAttributes="Bold" FontSize="22" Margin="4,0,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border BackgroundColor="White" Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout>
                        <Border BackgroundColor="#EEF1FF" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Label Text="📦" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Margin="0,16,0,0" Text="Products" TextColor="#808080" />
                        <Label Text="{Binding TotalProducts}" FontSize="28" FontAttributes="Bold" TextColor="#222" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout>
                        <Border BackgroundColor="#E8FFF5" WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Label Text="💰" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Margin="0,16,0,0" Text="Inventory Value" TextColor="#808080" />
                        <Label Text="{Binding TotalInventoryValue,StringFormat='{0:C0}'}" FontSize="22" FontAttributes="Bold" TextColor="#16A34A" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Quick Actions" FontAttributes="Bold" FontSize="22" />

            <Border BackgroundColor="White" Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="14">
                    <Border Grid.Row="0" Grid.Column="0" Padding="14" BackgroundColor="#F8FAFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📦" FontSize="20" />
                            <Label Text="Manage Products" FontAttributes="Bold" />
                            <Button Text="Open" Command="{Binding GoToProductsCommand}" HeightRequest="42" CornerRadius="12" BackgroundColor="#5B4DFF" TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Padding="14" BackgroundColor="#F5F7FF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🔌" FontSize="20" />
                            <Label Text="Device Inventory" FontAttributes="Bold" />
                            <Button Text="Open" Command="{Binding GoToDevicesCommand}" HeightRequest="42" CornerRadius="12" BackgroundColor="#4F46E5" TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Padding="14" BackgroundColor="#F0FDF4" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📈" FontSize="20" />
                            <Label Text="Monitoring" FontAttributes="Bold" />
                            <Button Text="Open" Command="{Binding GoToMonitoringCommand}" HeightRequest="42" CornerRadius="12" BackgroundColor="#16A34A" TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="#FFF7ED" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📝" FontSize="20" />
                            <Label Text="Reports &amp; Settings" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Reports" Command="{Binding GoToReportsCommand}" HeightRequest="42" CornerRadius="12" BackgroundColor="#D97706" TextColor="White" />
                                <Button Text="Settings" Command="{Binding GoToSettingsCommand}" HeightRequest="42" CornerRadius="12" BackgroundColor="#64748B" TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border BackgroundColor="White" Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Workstream" FontAttributes="Bold" FontSize="18" />
                    <Label Text="• Review pending inventory tasks" TextColor="#6B7280" />
                    <Label Text="• Verify device health alerts" TextColor="#6B7280" />
                    <Label Text="• Prepare the next report export" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

            <Button Text="🚪  Logout" Command="{Binding LogoutCommand}" HeightRequest="55" FontAttributes="Bold" FontSize="16" BackgroundColor="#FFF2F2" TextColor="#E53935" BorderColor="#FFD8D8" BorderWidth="1" CornerRadius="18" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#5B4DFF" HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>