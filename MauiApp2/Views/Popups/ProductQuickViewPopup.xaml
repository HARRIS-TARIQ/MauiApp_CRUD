<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:MauiApp2.Models"
               x:Class="MauiApp2.Views.Popups.ProductQuickViewPopup"
               x:DataType="models:Product"
               Color="Transparent">

    <!--
        CommunityToolkit.Maui.Views.Popup (v9+):
        - Ye "card" style popup hai, screen ke center mein overlay hota hai.
        - Show karne ka tareeqa code-behind mein: await this.ShowPopupAsync(new ProductQuickViewPopup(product));
        - Close(result) call karne se popup band ho jata hai aur result caller ko wapas milta hai.
    -->

    <Border
        WidthRequest="320"
        Padding="0"
        StrokeThickness="0"
        BackgroundColor="White">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="26"/>
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="#40000000" Offset="0,10" Radius="25" Opacity="0.4"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- Header / Hero -->
            <Border StrokeThickness="0" HeightRequest="110">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26,26,0,0"/>
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1">
                        <GradientStop Color="#6A5AE0" Offset="0"/>
                        <GradientStop Color="#4A36C8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Label
                    Text="📦"
                    FontSize="46"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Padding="22,18,22,22" Spacing="10">

                <Label
                    Text="{Binding Name}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#1F1F1F"/>

                <Label
                    Text="{Binding Category}"
                    FontSize="13"
                    TextColor="#8A8A8A"/>

                <Label
                    Text="{Binding Description}"
                    FontSize="13"
                    TextColor="#555"
                    MaxLines="3"
                    LineBreakMode="TailTruncation"/>

                <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">

                    <Border Grid.Column="0" Padding="10,6" BackgroundColor="#E9FFF1" StrokeThickness="0" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Price, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#16A34A" FontSize="14"/>
                    </Border>

                    <Border Grid.Column="1" Padding="10,6" BackgroundColor="#EEF2FF" StrokeThickness="0" HorizontalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontAttributes="Bold" TextColor="#5B4DFF" FontSize="14"/>
                    </Border>

                </Grid>

                <Button
                    Text="Close"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#5B4DFF"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="48"
                    Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>
