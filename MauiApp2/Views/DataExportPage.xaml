<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.DataExportPage"
             Title="Data Export"
             BackgroundColor="#F5F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Border StrokeThickness="0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Export Data" FontSize="24" FontAttributes="Bold" TextColor="#17203F" />
                    <Label Text="Create a secure data export package for reports or backup workflows." TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>
            <Border StrokeThickness="0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Export Options" FontSize="18" FontAttributes="Bold" />
                    <CheckBox />
                    <Label Text="Include attached diagnostics" />
                    <CheckBox />
                    <Label Text="Compress archive" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
