<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiApp2.ViewModels"
    x:Class="MauiApp2.Views.ProductCreatePage"
    x:DataType="vm:ProductCreateViewModel"
    BackgroundColor="#F6F8FC"
    Title="{Binding Title}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="24">

            <!-- Header -->

            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Create Product"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1F2937"/>

                <Label
                    Text="Fill in the product information below."
                    FontSize="14"
                    TextColor="#7B8794"/>

            </VerticalStackLayout>

            <!-- Product Image -->

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="25">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="18">

                    <Frame
                        WidthRequest="140"
                        HeightRequest="140"
                        CornerRadius="70"
                        Padding="0"
                        BackgroundColor="#EEF2FF"
                        HasShadow="False"
                        IsClippedToBounds="True">

                        <Image
                            Source="{Binding ImagePath}"
                            Aspect="AspectFill"/>

                    </Frame>

                    <Button
                        Text="📷 Choose Image"
                        Command="{Binding PickImageCommand}"
                        BackgroundColor="#EEF2FF"
                        TextColor="#5B4DFF"
                        CornerRadius="16"
                        Padding="20,10"/>

                </VerticalStackLayout>

            </Border>

            <!-- Product Details -->

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label
                        Text="Product Details"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Entry
                        Placeholder="Product Name"
                        Text="{Binding Name}"
                        ClearButtonVisibility="WhileEditing"/>

                    <Editor
                        Placeholder="Description"
                        Text="{Binding Description}"
                        HeightRequest="120"
                        AutoSize="TextChanges"/>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="15">

                        <Entry
                            Grid.Column="0"
                            Placeholder="Price"
                            Keyboard="Numeric"
                            Text="{Binding Price}"/>

                        <Entry
                            Grid.Column="1"
                            Placeholder="Quantity"
                            Keyboard="Numeric"
                            Text="{Binding Quantity}"/>

                    </Grid>

                    <Entry
                        Placeholder="Category"
                        Text="{Binding Category}"/>

                </VerticalStackLayout>

            </Border>

            <!-- Error -->

            <Border
                IsVisible="{Binding HasError}"
                BackgroundColor="#FFF1F2"
                Stroke="#FCA5A5"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#DC2626"
                    FontSize="13"/>

            </Border>

            <!-- Actions -->

            <Button
                Text="Save Product"
                Command="{Binding SaveCommand}"
                HeightRequest="56"
                CornerRadius="18"
                FontSize="17"
                FontAttributes="Bold"
                BackgroundColor="#5B4DFF"
                TextColor="White"/>

            <Button
                Text="Cancel"
                Command="{Binding CancelCommand}"
                HeightRequest="56"
                CornerRadius="18"
                BackgroundColor="White"
                BorderColor="#D6D9E0"
                BorderWidth="1"
                TextColor="#6B7280"/>

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="#5B4DFF"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>