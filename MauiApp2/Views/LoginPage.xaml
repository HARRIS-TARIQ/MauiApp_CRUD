<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp2.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp2.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="#E5E7EB" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B4DFF" Offset="0" />
                <GradientStop Color="#2B3C96" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <Grid Padding="24" VerticalOptions="Center">
                <Border BackgroundColor="White" StrokeThickness="0" Padding="28" MaximumWidthRequest="460" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 28">
                    <VerticalStackLayout Spacing="18">
                        <Border BackgroundColor="#EEF2FF" WidthRequest="72" HeightRequest="72" StrokeThickness="0" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                            <Label Text="MA" FontSize="24" FontAttributes="Bold" TextColor="#4F46E5" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Secure Access" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="Sign in to your operations console" FontSize="13" TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="✉" FontSize="16" VerticalOptions="Center" TextColor="#6B7280" />
                                    <Entry Grid.Column="1" Placeholder="Email" Text="{Binding Email}" Keyboard="Email" BackgroundColor="Transparent" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Text="🔒" FontSize="16" VerticalOptions="Center" TextColor="#6B7280" />
                                    <Entry Grid.Column="1" Placeholder="Password" Text="{Binding Password}" IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" />
                                    <Button Grid.Column="2" Text="👁" BackgroundColor="Transparent" TextColor="#6B7280" Command="{Binding TogglePasswordVisibilityCommand}" WidthRequest="36" HeightRequest="36" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding RememberMe}" />
                                    <Label Text="Remember me" VerticalOptions="Center" TextColor="#6B7280" />
                                </HorizontalStackLayout>
                                <Button Grid.Column="2" Text="Forgot?" BackgroundColor="Transparent" TextColor="#4F46E5" Command="{Binding ForgotPasswordCommand}" />
                            </Grid>

                            <Label Text="{Binding ErrorMessage}" TextColor="#D9534F" IsVisible="{Binding HasError}" FontSize="12" />

                            <Button Text="Sign In" Command="{Binding LoginCommand}" HeightRequest="48" CornerRadius="14" FontAttributes="Bold" TextColor="White">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6A4BFF" Offset="0" />
                                        <GradientStop Color="#4F46E5" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.IsEnabled>
                                    <Binding Path="IsBusy" Converter="{StaticResource InverseBoolConverter}" />
                                </Button.IsEnabled>
                            </Button>
                        </VerticalStackLayout>

                        <Label Text="Demo: admin@devzologics.com / Admin@123" FontSize="11" TextColor="#9CA3AF" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>