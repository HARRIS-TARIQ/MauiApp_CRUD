<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiApp2.ViewModels"
    x:Class="MauiApp2.Views.ProductDetailPage"
    x:DataType="vm:ProductDetailViewModel"
    BackgroundColor="#F6F8FC"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable Content -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="20"
                Spacing="24">

                <!-- Product Image -->

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>

                    <Grid HeightRequest="280">

                        <Image
                            Source="{Binding Product.ImagePath}"
                            Aspect="AspectFill"/>

                        <!-- Category Badge -->

                        <Border
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="16"
                            Padding="12,6"
                            BackgroundColor="#5B4DFF">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding Product.Category}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="White"/>

                        </Border>

                    </Grid>

                </Border>

                <!-- Product Name -->

                <Label
                    Text="{Binding Product.Name}"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#1F2937"/>

                <!-- Price -->

                <Label
                    Text="{Binding Product.Price,StringFormat='${0:F2}'}"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="#16A34A"/>

                <!-- Statistics -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15">

                    <!-- Stock -->

                    <Border
                        BackgroundColor="White"
                        Padding="16"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout>

                            <Label
                                Text="📦 Stock"
                                FontSize="14"
                                TextColor="#7B8794"/>

                            <Label
                                Text="{Binding Product.Quantity}"
                                FontSize="24"
                                FontAttributes="Bold"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Added Date -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Padding="16"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout>

                            <Label
                                Text="📅 Added"
                                FontSize="14"
                                TextColor="#7B8794"/>

                            <Label
                                Text="{Binding Product.CreatedDate,StringFormat='{0:dd MMM yyyy}'}"
                                FontSize="16"
                                FontAttributes="Bold"/>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- Description -->

                <Border
                    BackgroundColor="White"
                    Padding="20"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="12">

                        <Label
                            Text="Description"
                            FontSize="20"
                            FontAttributes="Bold"/>

                        <Label
                            Text="{Binding Product.Description}"
                            FontSize="15"
                            TextColor="#6B7280"
                            LineHeight="1.5"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom Action Bar -->

        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#ECECEC"
            StrokeThickness="1"
            Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="15">

                <Button
                    Grid.Column="0"
                    Text="✏ Edit"
                    Command="{Binding EditCommand}"
                    BackgroundColor="#5B4DFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="56"/>

                <Button
                    Grid.Column="1"
                    Text="🗑 Delete"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#FFF1F2"
                    TextColor="#DC2626"
                    BorderColor="#FCA5A5"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="56"/>

            </Grid>

        </Border>

        <ActivityIndicator
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="#5B4DFF"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

    </Grid>

</ContentPage>